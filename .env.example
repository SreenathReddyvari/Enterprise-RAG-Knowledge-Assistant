# Vector store: faiss | chroma
VECTOR_STORE_BACKEND=faiss
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

CHUNK_SIZE=500
CHUNK_OVERLAP=50

TOP_K=5
RERANK_TOP_N=3
USE_RERANKER=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# LLM provider: ollama | openai
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2-local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# sqlite (default) or e.g. postgresql+psycopg2://user:pass@localhost:5432/rag_db
DATABASE_URL=sqlite:///./rag_metadata.db

API_HOST=0.0.0.0
API_PORT=8020
STREAMLIT_PORT=8520
API_BASE_URL=http://localhost:8020

LOG_LEVEL=INFO
